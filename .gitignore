# --- Secrets and local configuration -----------------------------------------
# Real credentials (database URLs, model API keys) live only in local env files.
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# --- Python ------------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# --- Local databases ---------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.db-journal
*.dump
pgdata/
postgres-data/

# --- Generated files that may contain sensitive inputs -----------------------
# Raw prompts, model responses, request logs, and ad-hoc data exports can carry
# case content or credentials. Keep unreviewed output in these locations.
# Reviewed evidence from synthetic inputs is published under evaluations/
# (experiment runs) and tests/ (test reports); those folders are not ignored.
logs/
*.log
.local/
tmp/
model-io/
*.prompt.jsonl
*.response.jsonl

# --- Editor and OS files -----------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
